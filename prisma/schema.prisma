// Aljibe App - Registro de entregas de agua, pagos, gastos y liquidación con dueño
// Con autenticación: dueños y choferes, asignación de choferes a camiones

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Usuario — puede ser dueño o chofer
model Usuario {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  nombre        String
  telefono      String?
  role          String   @default("chofer")  // "dueno" | "chofer"
  // Si role=chofer, duenoId apunta al dueño que lo gestiona.
  // Si role=dueno, duenoId es null.
  duenoId       String?
  dueno         Usuario? @relation("DuenoChoferes", fields: [duenoId], references: [id])
  choferes      Usuario[] @relation("DuenoChoferes")
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())

  // Relaciones con datos del negocio
  camionesDueno     Camion[]         @relation("CamionDueno")
  asignaciones      CamionChofer[]
  vueltasComoChofer Vuelta[]         @relation("VueltaChofer")
  vueltasComoDueno  Vuelta[]         @relation("VueltaDueno")
  entregasComoChofer Entrega[]       @relation("EntregaChofer")
  entregasComoDueno  Entrega[]       @relation("EntregaDueno")
  gastosComoChofer  Gasto[]          @relation("GastoChofer")
  gastosComoDueno   Gasto[]          @relation("GastoDueno")
  clientesDueno     Cliente[]        @relation("ClienteDueno")
  pedidosComoChofer Pedido[]         @relation("PedidoChofer")
  pedidosComoDueno  Pedido[]         @relation("PedidoDueno")
  pedidosAsignados  Pedido[]         @relation("PedidoChoferAsignado")
  pedidosTomados    Pedido[]         @relation("PedidoTomadoPor")
  pedidosConPrioridad Pedido[]       @relation("PedidoPrioridadChofer")
  recurrentesAsignados PedidoRecurrente[] @relation("RecurrenteChoferAsignado")
  recurrentesComoDueno PedidoRecurrente[] @relation("RecurrenteDueno")
  clientesPreferidos  Cliente[]        @relation("ClienteChoferPreferido")
  configuracion     Configuracion?   @relation("ConfigDueno")
}

// Catálogo de clientes
model Cliente {
  id            String   @id @default(cuid())
  nombre        String
  rut           String?
  direccion     String?
  telefono      String?
  email         String?
  zona          String?
  precioEfectivoPorLitro       Float @default(0)
  precioTransferenciaPorLitro  Float @default(0)
  nota          String?
  creadoEn      DateTime @default(now())

  // Ubicación GPS (para navegación y futura venta online)
  lat           Float?
  lng           Float?

  // Acceso a la propiedad (cómo se entrega el agua)
  requiereIngresoPropiedad Boolean @default(false) // ¿hay que entrar a la propiedad?
  entregaDesdeAfuera       Boolean @default(false) // ¿se puede entregar desde afuera (ej. pasar manguera por encima del portón)?
  conexionExterna          Boolean @default(false) // ¿hay conexión/llave de paso externa que permite entregar sin el cliente?
  requiereClientePresente  Boolean @default(true)  // ¿el cliente debe estar presente para recibir?
  indicacionesAcceso       String?  // descripción libre: cómo entrar, dónde está el estanque, etc.

  // Chofer preferido — el chofer que creó al cliente tiene prioridad para atenderlo
  // (a menos que el dueño elija otro de manera permanente)
  choferPreferidoId  String?
  choferPreferido    Usuario? @relation("ClienteChoferPreferido", fields: [choferPreferidoId], references: [id])

  duenoId       String
  dueno         Usuario  @relation("ClienteDueno", fields: [duenoId], references: [id])

  entregas      Entrega[]
  pedidos       Pedido[]
  pedidosRecurrentes PedidoRecurrente[]
}

// Pedido de agua — creado cuando un cliente pide agua (por teléfono, etc.)
// Se convierte en Entrega cuando el chofer lo entrega.
model Pedido {
  id                String   @id @default(cuid())
  creadoEn          DateTime @default(now())

  // Datos del cliente (snapshoteados)
  clienteNombre     String
  clienteDireccion  String?
  clienteTelefono   String?
  clienteZona       String?
  clienteLat        Float?
  clienteLng        Float?
  clienteId         String?
  cliente           Cliente? @relation(fields: [clienteId], references: [id])

  // Detalle del pedido
  litrosSolicitados Float
  fechaSolicitada   DateTime?  // cuándo el cliente quiere que se entregue (opcional)
  metodoPagoPreferido String   @default("efectivo")  // efectivo | transferencia | mixto | credito
  indicacionesAcceso String?   // snapshot de indicaciones del cliente o custom
  nota              String?

  // Estado del pedido
  estado            String   @default("pendiente")  // pendiente | programado | en_ruta | entregado | cancelado
  entregaId         String?  @unique  // cuando se entrega, se vincula a la Entrega
  entrega           Entrega? @relation(fields: [entregaId], references: [id])

  // === Asignación de chofer ===
  // asignacionTipo: cómo se asigna el chofer que entregará
  //   - "manual": el dueño lo asigna a un chofer específico (choferAsignadoId)
  //   - "publicado": disponible para que cualquier chofer lo tome
  //   - "auto": el sistema sugiere según cercanía/capacidad (futuro)
  asignacionTipo    String   @default("manual")  // manual | publicado | auto

  // Chofer asignado manualmente por el dueño
  choferAsignadoId  String?
  choferAsignado    Usuario? @relation("PedidoChoferAsignado", fields: [choferAsignadoId], references: [id])

  // Chofer que tomó el pedido publicado (puede ser distinto del creador)
  tomadoPorChoferId String?
  tomadoPorChofer   Usuario? @relation("PedidoTomadoPor", fields: [tomadoPorChoferId], references: [id])

  // Prioridad: el chofer que creó el pedido (porque creó el cliente) tiene prioridad
  prioridadChoferId String?
  prioridadChofer   Usuario? @relation("PedidoPrioridadChofer", fields: [prioridadChoferId], references: [id])
  prioridadTipo     String   @default("ninguna")  // ninguna | permanente | caso

  publicadoEn       DateTime?  // cuándo se publicó para que choferes lo tomen

  // Quién creó el pedido y a qué dueño pertenece
  choferId          String?  // quién creó el pedido (puede ser null si lo creó el dueño o el sistema)
  chofer            Usuario? @relation("PedidoChofer", fields: [choferId], references: [id])

  duenoId           String
  dueno             Usuario  @relation("PedidoDueno", fields: [duenoId], references: [id])

  // Vuelta asignada (para planificación de ruta)
  vueltaId          String?
  vuelta            Vuelta?  @relation(fields: [vueltaId], references: [id])

  // Si viene de un pedido recurrente
  pedidoRecurrenteId String?
  pedidoRecurrente  PedidoRecurrente? @relation(fields: [pedidoRecurrenteId], references: [id])
}

// Pedido recurrente — genera pedidos automáticamente cada N días
// Ej: cliente que rellena el estanque semanalmente
model PedidoRecurrente {
  id                String   @id @default(cuid())
  creadoEn          DateTime @default(now())

  // Cliente (debe ser del catálogo)
  clienteId         String
  cliente           Cliente  @relation(fields: [clienteId], references: [id])

  // Detalle
  litrosSolicitados Float
  metodoPagoPreferido String @default("efectivo")
  nota              String?

  // Frecuencia
  frecuenciaDias    Int      // cada cuántos días generar el pedido (7 = semanal)
  fechaInicio       DateTime
  fechaProximaGeneracion DateTime  // próxima fecha en que se generará un pedido
  activo            Boolean  @default(true)

  // Asignación (igual que Pedido)
  asignacionTipo    String   @default("manual")  // manual | publicado
  choferAsignadoId  String?
  choferAsignado    Usuario? @relation("RecurrenteChoferAsignado", fields: [choferAsignadoId], references: [id])

  duenoId           String
  dueno             Usuario  @relation("RecurrenteDueno", fields: [duenoId], references: [id])

  // Pedidos generados por esta regla
  pedidos           Pedido[]
}

// Camión aljibe. Pertenece a un dueño. Puede tener varios choferes asignados.
model Camion {
  id          String   @id @default(cuid())
  nombre      String
  patente     String?
  capacidad   Int
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  duenoId     String
  dueno       Usuario  @relation("CamionDueno", fields: [duenoId], references: [id])

  vueltas     Vuelta[]
  choferes    CamionChofer[]
}

// Asignación chofer ↔ camión (muchos a muchos)
// Un camión puede tener varios choferes; un chofer puede tener varios camiones.
model CamionChofer {
  id          String   @id @default(cuid())
  camionId    String
  camion      Camion   @relation(fields: [camionId], references: [id], onDelete: Cascade)
  choferId    String
  chofer      Usuario  @relation(fields: [choferId], references: [id], onDelete: Cascade)
  asignadoEn  DateTime @default(now())

  @@unique([camionId, choferId])
}

// Una vuelta = un viaje del camión aljibe desde la planta de agua.
model Vuelta {
  id          String   @id @default(cuid())
  numero      Int
  iniciadaEn  DateTime @default(now())
  cerradaEn   DateTime?
  nota        String?
  activa      Boolean  @default(true)

  camionId    String?
  camion      Camion?  @relation(fields: [camionId], references: [id])

  choferId    String?
  chofer      Usuario? @relation("VueltaChofer", fields: [choferId], references: [id])

  duenoId     String
  dueno       Usuario  @relation("VueltaDueno", fields: [duenoId], references: [id])

  entregas    Entrega[]
  pedidos     Pedido[]
}

// Cada entrega/venta de agua a un cliente
model Entrega {
  id                String   @id @default(cuid())
  fecha             DateTime @default(now())

  clienteNombre     String
  clienteDireccion  String?
  clienteTelefono   String?
  clienteZona       String?
  clienteId         String?
  cliente           Cliente? @relation(fields: [clienteId], references: [id])

  vueltaId          String?
  vuelta            Vuelta?  @relation(fields: [vueltaId], references: [id])

  choferId          String?
  chofer            Usuario? @relation("EntregaChofer", fields: [choferId], references: [id])

  duenoId           String
  dueno             Usuario  @relation("EntregaDueno", fields: [duenoId], references: [id])

  lecturaAnterior   Float?
  lecturaActual     Float?
  litros            Float

  metodoPago        String   @default("efectivo")

  precioPorLitro    Float
  total             Float
  montoEfectivo     Float    @default(0)
  montoTransferencia Float   @default(0)
  montoRecibido     Float    @default(0)

  estadoPago        String   @default("pendiente")

  fotoMedidorUrl    String?
  nota              String?
  creadoEn          DateTime @default(now())

  // Si esta entrega viene de un pedido, se vincula aquí
  pedido            Pedido?
}

// Gastos asociados a la operación
model Gasto {
  id          String   @id @default(cuid())
  fecha       DateTime @default(now())
  tipo        String
  monto       Float
  descripcion String?
  fotoUrl     String?
  pagadoPor   String   @default("chofer")

  choferId    String?
  chofer      Usuario? @relation("GastoChofer", fields: [choferId], references: [id])

  duenoId     String
  dueno       Usuario  @relation("GastoDueno", fields: [duenoId], references: [id])

  creadoEn    DateTime @default(now())
}

// Configuración del negocio — una por dueño
model Configuracion {
  id                          String  @id @default(cuid())

  duenoId                     String  @unique
  dueno                       Usuario @relation("ConfigDueno", fields: [duenoId], references: [id])

  nombreChofer                String  @default("Chofer")
  nombreDueno                 String  @default("Dueño del Camión")

  capacidadCamion             Int     @default(17000)

  modoLiquidacion             String  @default("porcentaje")

  porcentajeComisionChofer    Float   @default(50)
  porcentajeComisionDueno     Float   @default(50)

  montoPorVueltaUnicoCliente  Float   @default(20000)
  montoPorVueltaMultiple      Float   @default(25000)

  precioEfectivoPorLitro      Float   @default(0)
  precioTransferenciaPorLitro Float   @default(0)

  tipoTributo                 String  @default("boleta_honorarios")
  porcentajeImpuesto          Float   @default(15.25)
  aplicaImpuestoSobre         String  @default("pago_chofer")

  // Permisos para choferes
  choferesPuedenEditarClientes Boolean @default(false)
  choferesPuedenCrearPedidos   Boolean @default(false)
}
