// Aljibe App - Registro de entregas de agua, pagos, gastos y liquidación con dueño

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Catálogo de clientes (para futuras funciones de venta online)
model Cliente {
  id            String   @id @default(cuid())
  nombre        String
  direccion     String?
  telefono      String?
  zona          String?
  // Precio por litro específico del cliente (sobreescribe los defaults globales).
  // Si es 0, se usan los precios globales según método de pago.
  precioEfectivoPorLitro       Float @default(0)
  precioTransferenciaPorLitro  Float @default(0)
  nota          String?
  creadoEn      DateTime @default(now())
  entregas      Entrega[]
}

// Camión aljibe. Cada camión tiene su propia capacidad.
// Preparado para multi-flota: cuando tengas más de un camión, agregas otro aquí.
model Camion {
  id          String   @id @default(cuid())
  nombre      String   // alias como "Camión grande", "Camión pequeño", "Patente ABCD12"
  patente     String?  // opcional
  capacidad   Int      // litros
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())
  vueltas     Vuelta[]
}

// Una vuelta = un viaje del camión aljibe desde la planta de agua.
// El chofer puede hacer varias vueltas al día. Cada vuelta agrupa 1+ entregas.
// El pago al chofer por vuelta depende de si entregó a 1 cliente (monto menor)
// o a múltiples clientes (monto mayor).
model Vuelta {
  id          String   @id @default(cuid())
  numero      Int      // número secuencial de vuelta (autoincremental global)
  iniciadaEn  DateTime @default(now())
  cerradaEn   DateTime?
  nota        String?
  activa      Boolean  @default(true) // solo una vuelta activa a la vez
  camionId    String?  // si es null, era una vuelta creada antes de tener camiones registrados
  camion      Camion?  @relation(fields: [camionId], references: [id])
  entregas    Entrega[]
}

// Cada entrega/venta de agua a un cliente
model Entrega {
  id                String   @id @default(cuid())
  fecha             DateTime @default(now())

  // Datos del cliente (snapshoteados para que no cambien si se edita el cliente después)
  clienteNombre     String
  clienteDireccion  String?
  clienteTelefono   String?
  clienteZona       String?
  clienteId         String?
  cliente           Cliente? @relation(fields: [clienteId], references: [id])

  // Vuelta a la que pertenece esta entrega (opcional, se autollenar con la activa)
  vueltaId          String?
  vuelta            Vuelta?  @relation(fields: [vueltaId], references: [id])

  // Lecturas del medidor
  lecturaAnterior   Float?
  lecturaActual     Float?
  litros            Float

  // Método de pago (determina qué precio usar por defecto)
  metodoPago        String   @default("efectivo")  // efectivo | transferencia | mixto | credito

  // Montos
  precioPorLitro    Float
  total             Float
  montoEfectivo     Float    @default(0)
  montoTransferencia Float   @default(0)
  montoRecibido     Float    @default(0)  // efectivo + transferencia recibidos

  // Estado del pago
  estadoPago        String   @default("pendiente")  // pendiente | pagado | parcial

  // Evidencia
  fotoMedidorUrl    String?
  nota              String?
  creadoEn          DateTime @default(now())
}

// Gastos asociados a la operación del camión aljibe
model Gasto {
  id          String   @id @default(cuid())
  fecha       DateTime @default(now())
  tipo        String   // agua_planta | combustible_camion | combustible_motobomba | cloro | mantenimiento | otro
  monto       Float
  descripcion String?
  fotoUrl     String?
  pagadoPor   String   @default("chofer")  // chofer | dueno  (quien pagó el gasto)
  creadoEn    DateTime @default(now())
}

// Configuración del negocio (registro único)
model Configuracion {
  id                          String  @id @default("default")

  // Partes
  nombreChofer                String  @default("Chofer")
  nombreDueno                 String  @default("Dueño del Camión")

  // Capacidad del camión — LEGACY: ahora se usa el modelo Camion.
  // Se mantiene como fallback si no hay camiones registrados.
  capacidadCamion             Int     @default(17000)

  // Modo de liquidación: "porcentaje" o "vuelta"
  modoLiquidacion             String  @default("porcentaje")

  // Modo "porcentaje"
  porcentajeComisionChofer    Float   @default(50)
  porcentajeComisionDueno     Float   @default(50)

  // Modo "vuelta" — pago al chofer por vuelta entregada
  montoPorVueltaUnicoCliente  Float   @default(20000)  // si la vuelta entrega a 1 solo cliente
  montoPorVueltaMultiple      Float   @default(25000)  // si la vuelta entrega a múltiples clientes

  // Precios por litro por defecto según método de pago
  precioEfectivoPorLitro      Float   @default(0)
  precioTransferenciaPorLitro Float   @default(0)

  // Impuestos
  tipoTributo                 String  @default("boleta_honorarios")  // boleta_honorarios | factura | otro | ninguno
  porcentajeImpuesto          Float   @default(15.25)  // % del tributo (15.25% boleta honorarios en Chile)
  aplicaImpuestoSobre         String  @default("pago_chofer")  // pago_chofer | utilidad_bruta | ventas_brutas
}
