// Aljibe App - Registro de entregas de agua, pagos, gastos y liquidación con dueño
// Con autenticación: dueños y choferes, asignación de choferes a camiones

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Usuario — puede ser dueño o chofer
model Usuario {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  nombre        String
  telefono      String?
  role          String   @default("chofer")  // "dueno" | "chofer"
  // Si role=chofer, duenoId apunta al dueño que lo gestiona.
  // Si role=dueno, duenoId es null.
  duenoId       String?
  dueno         Usuario? @relation("DuenoChoferes", fields: [duenoId], references: [id])
  choferes      Usuario[] @relation("DuenoChoferes")
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())

  // Relaciones con datos del negocio
  camionesDueno     Camion[]         @relation("CamionDueno")
  asignaciones      CamionChofer[]
  vueltasComoChofer Vuelta[]         @relation("VueltaChofer")
  vueltasComoDueno  Vuelta[]         @relation("VueltaDueno")
  entregasComoChofer Entrega[]       @relation("EntregaChofer")
  entregasComoDueno  Entrega[]       @relation("EntregaDueno")
  gastosComoChofer  Gasto[]          @relation("GastoChofer")
  gastosComoDueno   Gasto[]          @relation("GastoDueno")
  clientesDueno     Cliente[]        @relation("ClienteDueno")
  configuracion     Configuracion?   @relation("ConfigDueno")
}

// Catálogo de clientes
model Cliente {
  id            String   @id @default(cuid())
  nombre        String
  direccion     String?
  telefono      String?
  zona          String?
  precioEfectivoPorLitro       Float @default(0)
  precioTransferenciaPorLitro  Float @default(0)
  nota          String?
  creadoEn      DateTime @default(now())

  duenoId       String
  dueno         Usuario  @relation("ClienteDueno", fields: [duenoId], references: [id])

  entregas      Entrega[]
}

// Camión aljibe. Pertenece a un dueño. Puede tener varios choferes asignados.
model Camion {
  id          String   @id @default(cuid())
  nombre      String
  patente     String?
  capacidad   Int
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  duenoId     String
  dueno       Usuario  @relation("CamionDueno", fields: [duenoId], references: [id])

  vueltas     Vuelta[]
  choferes    CamionChofer[]
}

// Asignación chofer ↔ camión (muchos a muchos)
// Un camión puede tener varios choferes; un chofer puede tener varios camiones.
model CamionChofer {
  id          String   @id @default(cuid())
  camionId    String
  camion      Camion   @relation(fields: [camionId], references: [id], onDelete: Cascade)
  choferId    String
  chofer      Usuario  @relation(fields: [choferId], references: [id], onDelete: Cascade)
  asignadoEn  DateTime @default(now())

  @@unique([camionId, choferId])
}

// Una vuelta = un viaje del camión aljibe desde la planta de agua.
model Vuelta {
  id          String   @id @default(cuid())
  numero      Int
  iniciadaEn  DateTime @default(now())
  cerradaEn   DateTime?
  nota        String?
  activa      Boolean  @default(true)

  camionId    String?
  camion      Camion?  @relation(fields: [camionId], references: [id])

  choferId    String?
  chofer      Usuario? @relation("VueltaChofer", fields: [choferId], references: [id])

  duenoId     String
  dueno       Usuario  @relation("VueltaDueno", fields: [duenoId], references: [id])

  entregas    Entrega[]
}

// Cada entrega/venta de agua a un cliente
model Entrega {
  id                String   @id @default(cuid())
  fecha             DateTime @default(now())

  clienteNombre     String
  clienteDireccion  String?
  clienteTelefono   String?
  clienteZona       String?
  clienteId         String?
  cliente           Cliente? @relation(fields: [clienteId], references: [id])

  vueltaId          String?
  vuelta            Vuelta?  @relation(fields: [vueltaId], references: [id])

  choferId          String?
  chofer            Usuario? @relation("EntregaChofer", fields: [choferId], references: [id])

  duenoId           String
  dueno             Usuario  @relation("EntregaDueno", fields: [duenoId], references: [id])

  lecturaAnterior   Float?
  lecturaActual     Float?
  litros            Float

  metodoPago        String   @default("efectivo")

  precioPorLitro    Float
  total             Float
  montoEfectivo     Float    @default(0)
  montoTransferencia Float   @default(0)
  montoRecibido     Float    @default(0)

  estadoPago        String   @default("pendiente")

  fotoMedidorUrl    String?
  nota              String?
  creadoEn          DateTime @default(now())
}

// Gastos asociados a la operación
model Gasto {
  id          String   @id @default(cuid())
  fecha       DateTime @default(now())
  tipo        String
  monto       Float
  descripcion String?
  fotoUrl     String?
  pagadoPor   String   @default("chofer")

  choferId    String?
  chofer      Usuario? @relation("GastoChofer", fields: [choferId], references: [id])

  duenoId     String
  dueno       Usuario  @relation("GastoDueno", fields: [duenoId], references: [id])

  creadoEn    DateTime @default(now())
}

// Configuración del negocio — una por dueño
model Configuracion {
  id                          String  @id @default(cuid())

  duenoId                     String  @unique
  dueno                       Usuario @relation("ConfigDueno", fields: [duenoId], references: [id])

  nombreChofer                String  @default("Chofer")
  nombreDueno                 String  @default("Dueño del Camión")

  capacidadCamion             Int     @default(17000)

  modoLiquidacion             String  @default("porcentaje")

  porcentajeComisionChofer    Float   @default(50)
  porcentajeComisionDueno     Float   @default(50)

  montoPorVueltaUnicoCliente  Float   @default(20000)
  montoPorVueltaMultiple      Float   @default(25000)

  precioEfectivoPorLitro      Float   @default(0)
  precioTransferenciaPorLitro Float   @default(0)

  tipoTributo                 String  @default("boleta_honorarios")
  porcentajeImpuesto          Float   @default(15.25)
  aplicaImpuestoSobre         String  @default("pago_chofer")
}
