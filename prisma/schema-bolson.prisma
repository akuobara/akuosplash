// Bolsón — Schema Prisma separado para la app de marketplace de transporte
// Tablas prefijadas con "Bolson" para aislamiento total dentro de la misma BD.
// Para producción: usar variable de entorno BOLSON_DATABASE_URL con Turso separado.

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/bolson-client"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("BOLSON_DATABASE_URL")
}

// ============================================================
// USUARIOS Y SESIONES
// ============================================================

model BolsonUsuario {
  id            String   @id @default(cuid())
  email         String?  @unique
  telefono      String?  @unique
  nombre        String
  passwordHash  String?  // solo si usa email+password
  rol           String   @default("cliente") // cliente | transportista | superadmin
  activo        Boolean  @default(true)
  aprobado      Boolean  @default(false) // superadmin debe aprobar transportistas
  banned        Boolean  @default(false)
  banRazon      String?
  avatarUrl     String?
  creadoEn      DateTime @default(now())
  ultimoLoginEn DateTime?

  // Perfil transportista
  rutEmpresa           String?
  razonSocial          String?
  capacidadCamionKg    Int?
  patenteCamion        String?
  tieneGrua            Boolean @default(false)
  tieneMotoneta        Boolean @default(false)
  areasCobertura       String? // JSON array de comunas/zonas
  descripcionServicios String?

  // Relaciones
  sesiones              BolsonSesion[]
  solicitudes           BolsonSolicitud[]      @relation("SolicitudCliente")
  cotizaciones          BolsonCotizacion[]
  serviciosTransportista BolsonServicio[]      @relation("ServicioTransportista")
  serviciosChofer       BolsonServicio[]       @relation("ServicioChofer")
  fotosCargadas         BolsonFoto[]
  pagosRealizados       BolsonPago[]           @relation("PagoPagador")
  pagosRecibidos        BolsonPago[]           @relation("PagoReceptor")
  valoracionesHechas    BolsonValoracion[]     @relation("ValoracionDe")
  valoracionesRecibidas BolsonValoracion[]     @relation("ValoracionA")
  mensajesEnviados      BolsonMensaje[]
  notificaciones        BolsonNotificacion[]
  comisionesConfig      BolsonComisionConfig?
  auditLogs             BolsonAuditLog[]
  cuponesCreados        BolsonCuponDescuento[]

  @@index([rol, activo])
  @@index([telefono])
  @@index([email])
}

model BolsonSesion {
  id          String   @id @default(cuid())
  usuarioId  String
  usuario     BolsonUsuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  token       String   @unique
  creadoEn    DateTime @default(now())
  expiraEn    DateTime
  userAgent   String?
  ip          String?

  @@index([usuarioId])
  @@index([token])
}

model BolsonCodigoLogin {
  id         String   @id @default(cuid())
  telefono   String?
  email      String?
  codigo     String   // 6 dígitos
  creadoEn   DateTime @default(now())
  expiraEn   DateTime // 10 minutos
  usado      Boolean  @default(false)
  intentos   Int      @default(0)

  @@index([telefono])
  @@index([email])
}

// ============================================================
// CATÁLOGO DE CATEGORÍAS
// ============================================================

model BolsonCategoria {
  id          String  @id @default(cuid())
  slug        String  @unique // flete | mudanza | escombros
  nombre      String
  descripcion String?
  icono       String?
  activo      Boolean @default(true)
  orden       Int     @default(0)

  solicitudes BolsonSolicitud[]
}

// ============================================================
// SOLICITUDES DE TRANSPORTE (publicadas por clientes)
// ============================================================

model BolsonSolicitud {
  id            String   @id @default(cuid())
  creadoEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  // Cliente que la publicó
  clienteId     String
  cliente       BolsonUsuario @relation("SolicitudCliente", fields: [clienteId], references: [id], onDelete: Cascade)

  // Categoría
  categoriaId   String
  categoria     BolsonCategoria @relation(fields: [categoriaId], references: [id])

  // Detalle
  titulo        String
  descripcion   String
  volumenM3     Float?  // metros cúbicos
  pesoKg        Float?  // kilos
  cantidadItems Int     @default(1)
  requiereEmbalaje Boolean @default(false)
  requierePersonalExtra Boolean @default(false)
  requiereGrua  Boolean @default(false)
  requiereMotoneta Boolean @default(false)
  fotoUrl       String? // foto del objeto a transportar

  // Multi-punto: cargar en A,B,D y entregar en C,E (orden importa)
  // Los puntos se guardan en BolsonPunto (puntosCarga y puntosEntrega)

  // Fechas
  fechaFlexible    Boolean  @default(true)
  fechaMin         DateTime?
  fechaMax         DateTime?
  franjaHoraria    String?  // "mañana" | "tarde" | "noche" | "cualquiera"

  // Ubicación aproximada para mostrar en el mapa de solicitudes abiertas
  zonaOrigen  String?
  zonaDestino String?

  // Presupuesto del cliente (opcional)
  presupuestoMax Float?
  metodoPagoPreferido String? // efectivo | transferencia | tarjeta

  // Estado
  estado       String @default("abierta") // abierta | adjudicada | en_progreso | entregada | cancelada | vencida
  canceladaRazon String?
  cerradaEn    DateTime?

  // Cotización adjudicada (si la hay)
  cotizacionAdjudicadaId String?
  cotizacionAdjudicada   BolsonCotizacion? @relation("SolicitudAdjudicada", fields: [cotizacionAdjudicadaId], references: [id])

  // Relaciones
  puntos              BolsonPunto[]  // un solo array; filtrar por `tipo` para separar carga/entrega
  cotizaciones        BolsonCotizacion[]
  servicio            BolsonServicio?
  mensajes            BolsonMensaje[]
  notificacionesSolicitud BolsonNotificacion[] @relation("NotificacionSolicitud")

  @@index([clienteId, estado])
  @@index([categoriaId, estado])
  @@index([estado, creadoEn])
  @@index([zonaOrigen])
  @@index([zonaDestino])
}

model BolsonPunto {
  id           String  @id @default(cuid())
  solicitudId  String
  solicitud    BolsonSolicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  tipo         String  // "carga" | "entrega"
  orden        Int     // 1, 2, 3... para ordenar la ruta
  direccion    String
  comuna       String?
  referencia   String?  // descripción adicional
  lat          Float?
  lng          Float?
  contactoNombre String?
  contactoTelefono String?
  requiereAscensor Boolean @default(false)
  piso          Int?
  indicacionesAcceso String?

  @@index([solicitudId, tipo, orden])
}

// ============================================================
// COTIZACIONES (ofertas de transportistas)
// ============================================================

model BolsonCotizacion {
  id              String   @id @default(cuid())
  creadoEn        DateTime @default(now())
  actualizadaEn   DateTime @updatedAt

  solicitudId     String
  solicitud       BolsonSolicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  transportistaId String
  transportista   BolsonUsuario @relation(fields: [transportistaId], references: [id], onDelete: Cascade)

  monto           Float
  moneda          String   @default("CLP")
  tiempoEstimadoHoras Int?
  fechaPropuestaInicio DateTime?
  fechaPropuestaFin    DateTime?
  mensaje         String?
  // Si el transportista ofrece
  incluyePersonal Boolean @default(false)
  incluyeEmbalaje Boolean @default(false)
  incluyeGrua     Boolean @default(false)
  incluyeMotoneta Boolean @default(false)

  estado          String @default("pendiente") // pendiente | aceptada | rechazada | retirada
  rechazadaRazon  String?
  aceptadaEn      DateTime?

  // Si esta cotización fue adjudicada → se crea un BolsonServicio
  servicio        BolsonServicio?

  // Relación inversa desde BolsonSolicitud.cotizacionAdjudicada
  solicitudAdjudicada BolsonSolicitud[] @relation("SolicitudAdjudicada")

  @@index([solicitudId, estado])
  @@index([transportistaId, estado])
  @@unique([solicitudId, transportistaId]) // una cotización por transportista por solicitud
}

// ============================================================
// SERVICIOS (cotización adjudicada → servicio en marcha)
// ============================================================

model BolsonServicio {
  id           String   @id @default(cuid())
  creadoEn     DateTime @default(now())
  iniciadoEn   DateTime?
  completadoEn DateTime?
  canceladoEn  DateTime?

  solicitudId  String @unique
  solicitud    BolsonSolicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  cotizacionId String @unique
  cotizacion   BolsonCotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  transportistaId String
  transportista   BolsonUsuario @relation("ServicioTransportista", fields: [transportistaId], references: [id])

  choferId      String?
  chofer        BolsonUsuario? @relation("ServicioChofer", fields: [choferId], references: [id])

  camionPatente String?
  camionCapacidadKg Int?

  estado        String @default("asignado") // asignado | en_camino_carga | cargado | en_camino_entrega | entregado | completado | cancelado
  notaInterna   String?

  // Tracking
  ubicacionActualLat Float?
  ubicacionActualLng Float?
  ubicacionActualEn   DateTime?

  // Firma del cliente al recibir
  firmaClienteUrl String?
  firmaClienteEn  DateTime?

  // Métricas
  kmRecorridos   Float?
  litrosCombustible Float?
  horasTrabajadas Float?

  // Comisión superadmin
  comisionMonto  Float?
  comisionPagada Boolean @default(false)

  fotos          BolsonFoto[]
  pagos          BolsonPago[]
  valoraciones   BolsonValoracion[]

  @@index([transportistaId, estado])
  @@index([choferId, estado])
  @@index([estado, creadoEn])
}

model BolsonFoto {
  id         String   @id @default(cuid())
  creadoEn   DateTime @default(now())
  servicioId String
  servicio   BolsonServicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  tipo       String  // "carga" | "entrega" | "evidencia" | "problema"
  orden      Int     @default(0)
  url        String
  descripcion String?
  cargadoPorId String?
  cargadoPor BolsonUsuario? @relation(fields: [cargadoPorId], references: [id])

  @@index([servicioId, tipo])
}

// ============================================================
// PAGOS
// ============================================================

model BolsonPago {
  id          String   @id @default(cuid())
  creadoEn    DateTime @default(now())
  servicioId  String
  servicio    BolsonServicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)

  monto       Float
  moneda      String   @default("CLP")
  concepto    String   // "saldo_servicio" | "adelanto" | "comision_superadmin" | "ajuste"
  metodoPago  String   // efectivo | transferencia | tarjeta | webpay
  estado      String   @default("pendiente") // pendiente | confirmado | rechazado | devuelto
  referencia  String?  // id de transferencia, etc.

  pagadoPorId String?
  pagadoPor   BolsonUsuario? @relation("PagoPagador", fields: [pagadoPorId], references: [id])
  recibidoPorId String?
  recibidoPor BolsonUsuario? @relation("PagoReceptor", fields: [recibidoPorId], references: [id])

  comprobanteUrl String?

  @@index([servicioId, estado])
  @@index([pagadoPorId])
  @@index([recibidoPorId])
}

// ============================================================
// VALORACIONES (bidireccionales: cliente ↔ transportista)
// ============================================================

model BolsonValoracion {
  id          String   @id @default(cuid())
  creadoEn    DateTime @default(now())
  servicioId  String
  servicio    BolsonServicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)

  deUsuarioId String
  deUsuario   BolsonUsuario @relation("ValoracionDe", fields: [deUsuarioId], references: [id], onDelete: Cascade)

  aUsuarioId String
  aUsuario    BolsonUsuario @relation("ValoracionA", fields: [aUsuarioId], references: [id], onDelete: Cascade)

  rating      Int      // 1-5
  comentario  String?
  respuesta   String?  // respuesta del valorado

  @@unique([servicioId, deUsuarioId, aUsuarioId])
  @@index([aUsuarioId, creadoEn])
}

// ============================================================
// MENSAJES (chat entre cliente y transportista dentro de una solicitud)
// ============================================================

model BolsonMensaje {
  id           String   @id @default(cuid())
  creadoEn     DateTime @default(now())
  leidoEn      DateTime?

  solicitudId String
  solicitud   BolsonSolicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  remitenteId String
  remitente   BolsonUsuario @relation(fields: [remitenteId], references: [id], onDelete: Cascade)

  contenido   String
  tipo        String @default("texto") // texto | imagen | audio | ubicacion | cotizacion

  // Para mensajes tipo cotizacion o ubicacion
  metadata    String?

  @@index([solicitudId, creadoEn])
  @@index([remitenteId])
}

// ============================================================
// NOTIFICACIONES
// ============================================================

model BolsonNotificacion {
  id          String   @id @default(cuid())
  creadoEn    DateTime @default(now())
  leidaEn     DateTime?

  usuarioId   String
  usuario     BolsonUsuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  tipo        String // "nueva_cotizacion" | "cotizacion_aceptada" | "cotizacion_rechazada" | "servicio_actualizado" | "nuevo_mensaje" | "pago_recibido" | "valoracion_recibida" | "bienvenida" | "admin"
  titulo      String
  mensaje     String
  link        String? // ruta interna
  metadata    String?

  solicitud   BolsonSolicitud? @relation("NotificacionSolicitud", fields: [solicitudId], references: [id], onDelete: Cascade)
  solicitudId String?

  @@index([usuarioId, leidaEn])
}

// ============================================================
// CONFIGURACIÓN SUPERADMIN — COMISIONES
// ============================================================

model BolsonComisionConfig {
  id                  String   @id @default(cuid())
  creadoEn            DateTime @default(now())
  actualizadaEn       DateTime @updatedAt

  // Quién lo configuró
  superadminId        String  @unique
  superadmin          BolsonUsuario @relation(fields: [superadminId], references: [id])

  // Comisión % sobre cada servicio completado
  porcentajeComision  Float   @default(0) // 0 = sin comisión por defecto
  montoFijoComision   Float   @default(0) // monto fijo adicional opcional
  montoMinimoComision Float   @default(0) // mínimo a cobrar

  // Aplicar a
  aplicaPorCategoria  Boolean @default(false)
  categoriasConfig    String? // JSON: { "flete": 5, "mudanza": 7, "escombros": 3 }

  // Cobro de publicación premium (las publicaciones básicas son gratis)
  publicacionPremiumHabilitada Boolean @default(false)
  publicacionPremiumMonto Float @default(0)

  activo              Boolean  @default(true)
}

// ============================================================
// AUDIT LOG (superadmin actions)
// ============================================================

model BolsonAuditLog {
  id          String   @id @default(cuid())
  creadoEn    DateTime @default(now())
  superadminId String?
  superadmin  BolsonUsuario? @relation(fields: [superadminId], references: [id])
  accion      String   // "ban_usuario" | "aprobar_transportista" | "cambiar_comision" | "ver_servicio" | ...
  entidad     String?
  entidadId   String?
  detalles    String?  // JSON
  ip          String?

  @@index([superadminId, creadoEn])
  @@index([entidad, creadoEn])
}

// ============================================================
// SUSCRIPCIÓN CLIENTE — INTERFAZ DE APP MÓVIL
// ============================================================

model BolsonClienteApp {
  id            String   @id @default(cuid())
  creadoEn      DateTime @default(now())
  usuarioId     String  @unique
  nombre        String
  telefono      String
  email         String?
  pushToken     String?
  plataforma   String? // ios | android | web
  activo        Boolean @default(true)
  preferenciasNotif String? // JSON
  pedidosApp    BolsonPedidoApp[]
  movimientos   BolsonMovimientoSaldoClienteApp[]

  @@index([usuarioId])
}

model BolsonPedidoApp {
  id           String  @id @default(cuid())
  clienteAppId String
  clienteApp   BolsonClienteApp @relation(fields: [clienteAppId], references: [id], onDelete: Cascade)
  creadoEn     DateTime @default(now())
  categoria    String
  descripcion   String
  volumenM3    Float?
  pesoKg       Float?
  origenDireccion  String
  origenLat    Float?
  origenLng    Float?
  destinoDireccion String
  destinoLat   Float?
  destinoLng   Float?
  presupuestoMax Float?
  metodoPagoPreferido String?
  fechaFlexible Boolean @default(true)
  fechaMin     DateTime?
  fechaMax     DateTime?
  franjaHoraria String?
  estado       String  @default("publicado") // publicado | cotizado | aceptado | rechazado
  fotoUrl      String?

  @@index([clienteAppId, estado])
  @@index([categoria, estado])
}

model BolsonMovimientoSaldoClienteApp {
  id            String  @id @default(cuid())
  clienteAppId  String
  clienteApp    BolsonClienteApp @relation(fields: [clienteAppId], references: [id], onDelete: Cascade)
  fecha         DateTime @default(now())
  tipo          String // "abono" | "cargo" | "ajuste"
  monto         Float
  concepto      String
  referenciaId  String?
  referenciaTipo String?
  saldoAntes    Float
  saldoDespues  Float

  @@index([clienteAppId, fecha])
}

// ============================================================
// CUPONES Y FACTURAS
// ============================================================

model BolsonCuponDescuento {
  id          String  @id @default(cuid())
  codigo      String  @unique
  creadoEn    DateTime @default(now())
  creadoPorId String?
  creadoPor   BolsonUsuario? @relation(fields: [creadoPorId], references: [id])
  tipo        String  // "porcentaje" | "fijo"
  valor       Float
  usosMaximos Int?
  usosActuales Int @default(0)
  validoDesde DateTime?
  validoHasta DateTime?
  activo      Boolean @default(true)
}

model BolsonFacturaAdmin {
  id            String   @id @default(cuid())
  creadoEn      DateTime @default(now())
  numero        Int      @unique
  servicioId    String?
  montoNeto     Float
  iva           Float
  montoTotal    Float
  emisorRut     String
  emisorNombre  String
  receptorRut   String
  receptorNombre String
  receptorDireccion String?
  pdfUrl        String?
  estado       String @default("emitida") // emitida | pagada | anulada
}
